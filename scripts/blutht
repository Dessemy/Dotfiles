#!/bin/sh
set -e

notify_bt() {
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -t 2000 "Bluetooth" "$1"
}

bt_powered() {
    bluetoothctl show 2>/dev/null | awk -F': ' '/Powered/{print $2; exit}'
}

ensure_powered() {
    [ "$(bt_powered)" = "yes" ] && return 0
    bluetoothctl power on >/dev/null 2>&1
    sleep 1
    [ "$(bt_powered)" = "yes" ]
}

if ! command -v bluetoothctl >/dev/null 2>&1; then
    notify-send -u critical "Bluetooth Error" "bluetoothctl is not installed"
    exit 1
fi

power=$(bt_powered)
[ -z "$power" ] && power="unknown"
power_label=$(printf '%s' "$power" | tr '[:lower:]' '[:upper:]')

action=$(printf 'Scan Devices\nConnect\nDisconnect\nToggle Power\nStatus\n' | \
    wmenu "$@" -l 5 -p "Bluetooth (power: ${power_label})>") || exit 0
[ -z "$action" ] && exit 0

case "$action" in
    "Toggle Power")
        if [ "$power" = "yes" ]; then
            if bluetoothctl power off >/dev/null 2>&1; then
                notify_bt "Bluetooth powered off"
            else
                notify_bt "Failed to power off Bluetooth"
            fi
        else
            if bluetoothctl power on >/dev/null 2>&1; then
                notify_bt "Bluetooth powered on"
            else
                notify_bt "Failed to power on Bluetooth"
            fi
        fi
        ;;

    "Status")
        info=$(bluetoothctl show 2>/dev/null)
        if [ -n "$info" ]; then
            pw=$(printf '%s\n' "$info" | awk -F': ' '/^\s*Powered/{print $2}')
            disc=$(printf '%s\n' "$info" | awk -F': ' '/^\s*Discoverable/{print $2}')
            pair=$(printf '%s\n' "$info" | awk -F': ' '/^\s*Pairable/{print $2}')
            notify_bt "Powered: ${pw:-unknown} | Discoverable: ${disc:-unknown} | Pairable: ${pair:-unknown}"
        else
            notify_bt "No status available"
        fi
        ;;

    "Scan Devices")
        if ! ensure_powered; then
            notify-send -u critical "Bluetooth Error" "Failed to power on adapter"
            exit 1
        fi
        notify_bt "Scanning for 5 seconds..."
        bluetoothctl --timeout 5 scan on >/dev/null 2>&1 || true
        notify_bt "Scan complete"
        ;;

    "Connect")
        if ! ensure_powered; then
            notify-send -u critical "Bluetooth Error" "Failed to power on adapter"
            exit 1
        fi

        devices=$(bluetoothctl devices 2>/dev/null | sed -E 's/^Device //')
        if [ -z "$devices" ]; then
            notify_bt "No devices found. Try Scan Devices first."
            exit 0
        fi

        chosen=$(printf '%s\n' "$devices" | wmenu "$@" -l 15 -p "Connect>") || exit 0
        [ -z "$chosen" ] && exit 0

        mac=$(printf '%s\n' "$chosen" | awk '{print $1}')
        name=$(printf '%s\n' "$chosen" | cut -d' ' -f2-)

        if bluetoothctl connect "$mac" >/dev/null 2>&1; then
            notify_bt "Connected to ${name}"
        else
            notify_bt "Failed to connect to ${name}"
        fi
        ;;

    "Disconnect")
        devices=$(bluetoothctl devices Connected 2>/dev/null | sed -E 's/^Device //')
        if [ -z "$devices" ]; then
            devices=$(bluetoothctl devices 2>/dev/null | sed -E 's/^Device //')
        fi
        if [ -z "$devices" ]; then
            notify_bt "No devices to disconnect"
            exit 0
        fi

        chosen=$(printf '%s\n' "$devices" | wmenu "$@" -l 15 -p "Disconnect>") || exit 0
        [ -z "$chosen" ] && exit 0

        mac=$(printf '%s\n' "$chosen" | awk '{print $1}')
        name=$(printf '%s\n' "$chosen" | cut -d' ' -f2-)

        if bluetoothctl disconnect "$mac" >/dev/null 2>&1; then
            notify_bt "Disconnected ${name}"
        else
            notify_bt "Failed to disconnect ${name}"
        fi
        ;;
esac
