#!/bin/sh

SAVE_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$SAVE_DIR"
FILEPATH="$SAVE_DIR/screenshot_$(date +'%Y-%m-%d_%H-%M-%S').png"
MODE="${1:-full}"

if [ "$MODE" = "area" ]; then
    timeout 10 slurp > /tmp/selection.txt 2>/dev/null
    if [ $? -eq 0 ] && [ -s /tmp/selection.txt ]; then
        grim -g "$(cat /tmp/selection.txt)" "$FILEPATH"
    else
        rm -f /tmp/selection.txt
        exit 1
    fi
    rm -f /tmp/selection.txt
else
    grim "$FILEPATH"
fi

if [ -f "$FILEPATH" ]; then
    wl-copy < "$FILEPATH"
    notify-send "Screenshot" "Saved" 2>/dev/null
fi
