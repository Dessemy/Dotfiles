#!/bin/sh
set -e

notify_power() {
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -t 1800 "Power Mode" "$1"
}

apply_power_mode() {
    mode="$1"

    case "$mode" in
        Powersave)   sudo powerctl apply powersave   || return 1 ;;
        Balanced)    sudo powerctl apply balanced    || return 1 ;;
        Performance) sudo powerctl apply performance || return 1 ;;
    esac

    notify_power "$mode applied"
}

if ! sudo -v; then
    notify-send -u critical "Power Mode Error" "sudo authentication failed"
    exit 1
fi

chosen=$(printf 'Performance\nBalanced\nPowersave\n' | \
    wmenu "$@" -l 3 -p "Power Mode>") || exit 0

[ -z "$chosen" ] && exit 0

apply_power_mode "$chosen" || {
    notify-send -u critical "Power Mode Error" "Failed to apply $chosen"
    exit 1
}
