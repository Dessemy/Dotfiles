#!/bin/bash
set -euo pipefail

STATE_FILE="/etc/gpu-switch-state"

require_root() {
    [ "$(id -u)" -eq 0 ] || { echo "gpu-switch: must run as root" >&2; exit 1; }
}

get_intel_pci() {
    lspci -nn | awk '/VGA compatible controller.*Intel/ || /Display controller.*Intel/ {
        match($0, /([0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]/)
        if (RSTART > 0) print substr($0, RSTART, RLENGTH)
    }' | head -1
}

get_nvidia_pci() {
    lspci -nn | awk '/VGA compatible controller.*NVIDIA/ || /3D controller.*NVIDIA/ {
        match($0, /([0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]/)
        if (RSTART > 0) print substr($0, RSTART, RLENGTH)
    }' | head -1
}

get_amd_pci() {
    lspci -nn | awk '/VGA compatible controller.*AMD/ || /VGA compatible controller.*ATI/ {
        match($0, /([0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]/)
        if (RSTART > 0) print substr($0, RSTART, RLENGTH)
    }' | head -1
}

sysfs_pci() {
    # Normalize PCI address for sysfs: always prefix with 0000: if no domain present.
    case "$1" in
        ????:*) echo "$1" ;;
        *)      echo "0000:${1}" ;;
    esac
}

unbind_driver() {
    local pci
    pci=$(sysfs_pci "$1")
    local driver_path="/sys/bus/pci/devices/${pci}/driver"
    if [ -L "$driver_path" ]; then
        local driver
        driver=$(basename "$(readlink "$driver_path")")
        echo "${pci}" > "/sys/bus/pci/drivers/${driver}/unbind" 2>/dev/null || true
    fi
}

remove_nvidia_modules() {
    rmmod nvidia_drm 2>/dev/null || true
    rmmod nvidia_modeset 2>/dev/null || true
    rmmod nvidia_uvm 2>/dev/null || true
    rmmod nvidia 2>/dev/null || true
}

remove_amd_modules() {
    rmmod amdgpu 2>/dev/null || true
    rmmod radeon 2>/dev/null || true
}

power_off_gpu() {
    local raw_pci="$1"
    local gpu_name="$2"
    local pci
    pci=$(sysfs_pci "$raw_pci")

    echo "Powering off ${gpu_name} (${pci})..."

    if echo "$gpu_name" | grep -qi nvidia; then
        remove_nvidia_modules
    elif echo "$gpu_name" | grep -qi amd; then
        remove_amd_modules
    fi

    unbind_driver "$raw_pci"

    local remove_path="/sys/bus/pci/devices/${pci}/remove"
    if [ -w "$remove_path" ]; then
        echo 1 > "$remove_path"
        echo "GPU ${gpu_name} fully removed from PCI bus."
    else
        local power_path="/sys/bus/pci/devices/${pci}/power/control"
        if [ -w "$power_path" ]; then
            echo auto > "$power_path"
            echo "GPU ${gpu_name} set to auto power management."
        fi
    fi
}

power_on_gpu() {
    local raw_pci="$1"
    local gpu_name="$2"
    local pci
    pci=$(sysfs_pci "$raw_pci")

    echo "Powering on ${gpu_name} (${pci})..."

    local remove_path="/sys/bus/pci/devices/${pci}/remove"
    if [ -f "$remove_path" ] || ! lspci -s "${pci}" >/dev/null 2>&1; then
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
        sleep 1
    fi

    local power_path="/sys/bus/pci/devices/${pci}/power/control"
    if [ -w "$power_path" ]; then
        echo on > "$power_path" 2>/dev/null || true
    fi

    if echo "$gpu_name" | grep -qi nvidia; then
        modprobe nvidia 2>/dev/null || true
        modprobe nvidia_uvm 2>/dev/null || true
        modprobe nvidia_modeset 2>/dev/null || true
        modprobe nvidia_drm 2>/dev/null || true
    elif echo "$gpu_name" | grep -qi amd; then
        modprobe amdgpu 2>/dev/null || true
    fi
}

detect_dual_gpu() {
    local intel nvidia amd
    intel=$(get_intel_pci)
    nvidia=$(get_nvidia_pci)
    amd=$(get_amd_pci)

    local count=0
    [ -n "$intel" ] && count=$((count + 1))
    [ -n "$nvidia" ] && count=$((count + 1))
    [ -n "$amd" ] && count=$((count + 1))

    if [ "$count" -lt 2 ]; then
        echo "No dual GPU detected." >&2
        exit 1
    fi

    if [ -n "$nvidia" ]; then
        echo "nvidia:${nvidia}"
    elif [ -n "$amd" ]; then
        echo "amd:${amd}"
    fi
}

detect_active_gpu() {
    local nvidia_pci
    nvidia_pci=$(get_nvidia_pci)
    if [ -n "$nvidia_pci" ]; then
        local driver_path="/sys/bus/pci/devices/$(sysfs_pci "$nvidia_pci")/driver"
        if [ -L "$driver_path" ]; then
            echo "nvidia"
            return
        fi
    fi
    echo "integrated"
}

do_switch() {
    local target="${1:-}"
    local intel nvidia amd
    intel=$(get_intel_pci)
    nvidia=$(get_nvidia_pci)
    amd=$(get_amd_pci)

    local discrete_type discrete_pci
    if [ -n "$nvidia" ]; then
        discrete_type="nvidia"
        discrete_pci="$nvidia"
    elif [ -n "$amd" ]; then
        discrete_type="amd"
        discrete_pci="$amd"
    else
        echo "No discrete GPU found." >&2
        exit 1
    fi

    case "$target" in
        integrated|int)
            power_off_gpu "$discrete_pci" "$discrete_type"
            echo "integrated" > "$STATE_FILE"
            echo "Switched to integrated GPU. Discrete GPU fully powered off."
            ;;
        discrete|gpu)
            power_on_gpu "$discrete_pci" "$discrete_type"
            echo "discrete" > "$STATE_FILE"
            echo "Switched to discrete GPU (${discrete_type})."
            ;;
        *)
            echo "Usage: gpu-switch {integrated|discrete}" >&2
            echo "  integrated/int  - Power off discrete GPU completely" >&2
            echo "  discrete/gpu    - Enable discrete GPU" >&2
            exit 1
            ;;
    esac
}

do_status() {
    local current
    current=$(detect_active_gpu)
    echo "Active GPU: ${current}"
    if [ -f "$STATE_FILE" ]; then
        echo "Last switch: $(cat "$STATE_FILE")"
    fi
}

do_toggle() {
    local current
    current=$(detect_active_gpu)

    if [ "$current" = "nvidia" ]; then
        do_switch integrated
    else
        do_switch discrete
    fi
}

case "${1:-}" in
    switch)
        require_root
        do_switch "${2:-}"
        ;;
    toggle)
        require_root
        do_toggle
        ;;
    status)
        do_status
        ;;
    *)
        echo "Usage: gpu-switch {switch <integrated|discrete>|toggle|status}" >&2
        echo "  switch integrated - Power off discrete GPU completely (not just idle)" >&2
        echo "  switch discrete   - Enable discrete GPU" >&2
        echo "  toggle            - Toggle between integrated and discrete" >&2
        echo "  status            - Show current GPU status" >&2
        exit 1
        ;;
esac
