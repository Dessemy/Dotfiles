#!/bin/sh
set -e

SELF=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")

APP_DIRS="/usr/share/applications $HOME/.local/share/applications"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
CACHE_FILE="$HOME/.cache/current_wallpaper"
WAYLOCK_OPTS="-init-color 0x1a1b26 -input-color 0x7aa2f7 -input-alt-color 0xad8ee6 -fail-color 0xf7768e"

list_apps() {
    for dir in $APP_DIRS; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.desktop; do
            [ -f "$f" ] || continue
            grep -q '^NoDisplay=true' "$f" && continue

            name=$(grep -m1 '^Name=' "$f" | cut -d'=' -f2-)
            exec_raw=$(grep -m1 '^Exec=' "$f" | cut -d'=' -f2-)

            [ -z "$name" ] && continue
            [ -z "$exec_raw" ] && continue

            exec_clean=$(echo "$exec_raw" | sed -E 's/%[fFuUdDnNickvm]//g')

            printf '%s\t%s\n' "$name" "$exec_clean"
        done
    done | sort -u -t"$(printf '\t')" -k1,1
}

calc_line() {
    q="$1"
    [ -z "$q" ] && return 0

    case "$q" in
        *[!0-9+\-*/^\(\).\ ]*) return 0 ;;
    esac
    case "$q" in
        *[0-9]*) : ;;
        *) return 0 ;;
    esac

    result=$(printf '%s\n' "$q" | bc -l 2>/dev/null) || return 0
    [ -z "$result" ] && return 0
    printf '= %s\n' "$result"
}

if [ "$1" = "--calc-and-menu" ]; then
    calc_line "$2"
    printf 'Apps\nClipboard\nSystem\nPower Mode\nWallpaper\nUpdate\n'
    exit 0
fi

run_applauncher() {
    chosen=$(list_apps | fzf \
        --prompt='Launch > ' \
        --height=100% \
        --layout=reverse \
        --border=sharp \
        --with-nth=1 \
        --delimiter='\t')

    [ -z "$chosen" ] && return 0

    cmd=$(printf '%s' "$chosen" | cut -f2-)
    setsid -f sh -c "$cmd" >/dev/null 2>&1
    sleep 0.3
}

run_clipboard() {
    selected=$(cliphist list | fzf \
        --prompt='Clipboard > ' \
        --height=100% \
        --layout=reverse \
        --border=sharp \
        --preview 'echo {}' \
        --preview-window up:3:wrap:border-sharp)

    [ -z "$selected" ] && return 0

    printf '%s' "$selected" | cliphist decode | wl-copy

    command -v notify-send >/dev/null 2>&1 && notify-send "Clipboard" "Item copied"
}

run_system() {
    clear
    command -v fastfetch >/dev/null 2>&1 && fastfetch

    options="Lock\nLogout\nReboot\nPoweroff"

    chosen=$(printf "$options" | fzf \
        --prompt='Power > ' \
        --height=40% \
        --layout=reverse \
        --border=sharp)

    [ -z "$chosen" ] && return 0

    case "$chosen" in
        Lock)
            waylock $WAYLOCK_OPTS
            ;;
        Logout)
            pkill -TERM -x dwl
            ;;
        Reboot)
            loginctl reboot
            ;;
        Poweroff)
            loginctl poweroff
            ;;
    esac
}



notify_power() {
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -t 1800 "Power Mode" "$1"
}

has_nvidia_gpu() {
    command -v lspci >/dev/null 2>&1 || return 1
    lspci 2>/dev/null | grep -qiE 'NVIDIA|NVIDIA Corporation'
}

set_refresh_rate() {
    target="$1"
    command -v wlr-randr >/dev/null 2>&1 || return 0

    if [ "$target" = "lowest" ]; then
        sync_state=disabled
    else
        sync_state=enabled
    fi
    set_adaptive_sync "$sync_state"

    outputs=$(wlr-randr 2>/dev/null | awk '
        /^[^[:space:]]/ { if (name != "" && enabled == "yes") print name; name=$1; enabled=""; next }
        /^[[:space:]]+Enabled:/ { enabled=$2 }
        END { if (name != "" && enabled == "yes") print name }
    ')

    for output in $outputs; do
        current_line=$(wlr-randr 2>/dev/null | awk -v o="$output" '
            $0 ~ "^" o "[[:space:]]" {inside=1; next}
            inside && /^[^[:space:]]/ {exit}
            inside && /current/ {print; exit}
        ')

        resolution=$(printf '%s\n' "$current_line" |
            sed -nE 's/^[[:space:]]*([0-9]+x[0-9]+) px,.*/\1/p')
        [ -n "$resolution" ] || continue

        rates=$(wlr-randr 2>/dev/null | awk -v o="$output" -v r="$resolution" '
            $0 ~ "^" o "[[:space:]]" {inside=1; next}
            inside && /^[^[:space:]]/ {exit}
            inside && $0 ~ ("^[[:space:]]+" r " px,") {
                line=$0
                sub(/^.*px,[[:space:]]*/, "", line)
                sub(/[[:space:]]+Hz.*$/, "", line)
                print line
            }
        ')

        [ -n "$rates" ] || continue

        if [ "$target" = "lowest" ]; then
            rate=$(printf '%s\n' "$rates" | sort -n | head -n1)
        else
            rate=$(printf '%s\n' "$rates" | sort -n | tail -n1)
        fi

        [ -n "$rate" ] || continue

        wlr-randr --output "$output" --mode "${resolution}@${rate}Hz" \
            >/dev/null 2>&1 || \
        wlr-randr --output "$output" --mode "${resolution}@${rate}" \
            >/dev/null 2>&1 || true

        mkdir -p "$HOME/.cache"
        printf '%s %s@%sHz %s\n' "$output" "$resolution" "$rate" "$sync_state" \
            > "$HOME/.cache/refresh-rate-state"
    done
}

set_adaptive_sync() {
    state="$1"
    command -v wlr-randr >/dev/null 2>&1 || return 0

    wlr-randr 2>/dev/null | awk '
        /^[^[:space:]]/ { if (name != "" && enabled == "yes") print name; name=$1; enabled=""; next }
        /^[[:space:]]+Enabled:/ { enabled=$2 }
        END { if (name != "" && enabled == "yes") print name }
    ' |
        while read -r output; do
            [ -n "$output" ] || continue
            wlr-randr --output "$output" --adaptive-sync "$state" \
                >/dev/null 2>&1 || true
        done
}

set_gpu_mode() {
    mode="$1"

    command -v envycontrol >/dev/null 2>&1 || return 0

    case "$mode" in
        integrated) out=$(sudo envycontrol -s integrated 2>&1) ;;
        hybrid)     out=$(sudo envycontrol -s hybrid 2>&1) ;;
        nvidia)     out=$(sudo envycontrol -s nvidia 2>&1) ;;
    esac

    if [ $? -ne 0 ]; then
        notify_power "GPU mode switch to $mode failed: $out"
    fi
}

set_kernel() {
    target="$1"
    sudo test -f /boot/grub/grub.cfg || return 0

    if [ "$target" = "zen" ]; then
        pat="linux-zen"
    else
        pat="linux"
    fi

    id=$(sudo cat /boot/grub/grub.cfg 2>/dev/null | awk -v pat="$pat" -v q="'" '
        /^menuentry / {
            line = $0
            n = 0
            while ((i = index(line, q)) > 0) {
                line = substr(line, i+1)
                j = index(line, q)
                if (j == 0) break
                n++
                tok[n] = substr(line, 1, j-1)
                line = substr(line, j+1)
            }
            cur_title = tok[1]
            cur_id = tok[n]
            next
        }
        /^[[:space:]]*linux[[:space:]]+\/boot\/vmlinuz-/ {
            if (cur_title !~ /fallback/ && $0 ~ ("vmlinuz-" pat "([[:space:]]|$)")) {
                print cur_id
                exit
            }
        }
    ')

    [ -n "$id" ] || return 0

    sudo grub-set-default "$id" >/dev/null 2>&1 || true
}

set_tlp_persistent() {
    code="$1"
    sudo mkdir -p /etc/tlp.d
    sudo tee /etc/tlp.d/90-power-mode-override.conf >/dev/null <<TLPCONF
TLP_DEFAULT_MODE=$code
TLP_PERSISTENT_DEFAULT=1
TLPCONF
}

apply_power_mode() {
    mode="$1"

    case "$mode" in
        "Power Saver")
            sudo tlp power-saver || return 1
            set_tlp_persistent SAV
            set_refresh_rate lowest
            set_gpu_mode integrated
            set_kernel default
            notify_power "Power Saver — rebooting..."
            ;;
        "Balanced")
            sudo tlp balanced || return 1
            set_tlp_persistent BAL
            set_refresh_rate lowest
            set_gpu_mode hybrid
            set_kernel default
            notify_power "Balanced — rebooting..."
            ;;
        "Performance")
            sudo tlp performance || return 1
            set_tlp_persistent PRF
            set_refresh_rate highest
            set_gpu_mode nvidia
            set_kernel zen
            notify_power "Performance — rebooting..."
            ;;
        "Ultra Power Saver")
            sudo tlp power-saver || return 1
            set_tlp_persistent SAV
            set_refresh_rate lowest
            set_gpu_mode integrated
            set_kernel default

            sudo sh -c '
                for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
                    [ -w "$f" ] && printf "%s" power > "$f" 2>/dev/null
                done
                for f in /sys/class/scsi_host/host*/link_power_management_policy; do
                    [ -w "$f" ] && printf "%s" min_power > "$f" 2>/dev/null
                done
            ' || true

            notify_power "Ultra Power Saver — rebooting..."
            ;;
    esac

    sleep 1
    sudo reboot
}

run_power_mode() {
    if ! command -v tlp >/dev/null 2>&1; then
        notify-send -u critical "Power Mode Error" "TLP is not installed"
        return 1
    fi

    if ! sudo -v; then
        notify-send -u critical "Power Mode Error" "sudo authentication failed"
        return 1
    fi

    current=$(sudo -n tlp-stat -s 2>/dev/null |
        awk -F'= ' '/Power profile/ {print $2; exit}')
    [ -z "$current" ] && current="unknown"

    chosen=$(printf '%s\n' \
        "Performance" \
        "Balanced" \
        "Power Saver" \
        "Ultra Power Saver" \
        "Check Current Mode: $current" |
        fzf \
        --prompt='Power Mode > ' \
        --height=50% \
        --layout=reverse \
        --border=sharp)

    [ -z "$chosen" ] && return 0

    case "$chosen" in
        "Power Saver"|"Balanced"|"Performance"|"Ultra Power Saver")
            apply_power_mode "$chosen" || {
                notify-send -u critical "Power Mode Error" \
                    "Failed to apply $chosen"
                return 1
            }
            ;;
        "Check Current Mode:"*)
            foot -e sh -c '
                sudo tlp-stat -s
                printf "\n--- CPU / EPP ---\n"
                sudo tlp-stat -p
                printf "\nPress Enter to close..."
                read -r _
            '
            ;;
    esac
}

run_wallpaper() {
    if [ ! -d "$WALLPAPER_DIR" ]; then
        notify-send -u critical "Wallpaper Error" "Directory $WALLPAPER_DIR not found"
        return 1
    fi

    cd "$WALLPAPER_DIR" || return 1
    selected=$(find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
        | sed 's|^\./||' \
        | fzf --preview 'chafa --format symbols --symbols block --stretch --size="${FZF_PREVIEW_COLUMNS}x$((FZF_PREVIEW_LINES-0))" {}' \
        --border=sharp \
        --preview-window=right:65%:wrap:border-sharp \
        --prompt="  Wallpaper > ")

    [ -z "$selected" ] && return 0

    FULL_PATH="$WALLPAPER_DIR/$selected"

    pkill -x swaybg 2>/dev/null || true
    sleep 0.3

    setsid -f swaybg -i "$FULL_PATH" -m fill >/dev/null 2>&1 &

    echo "$FULL_PATH" > "$CACHE_FILE"

    notify-send -i "$FULL_PATH" "Wallpaper Changed" "Now showing: $selected"
}

run_update() {
    echo "==> Syncing mirrors and upgrading system ..."
    set +e
    yay -Syu
    status=$?
    set -e

    echo
    if [ "$status" -eq 0 ]; then
        echo "==> Update finished successfully."
    else
        echo "==> Update finished with errors (exit code $status). Check the output above."
    fi

    printf 'Press Enter to close...'
    read -r _
}

chosen=$(printf 'Apps\nClipboard\nSystem\nPower Mode\nWallpaper\nUpdate\n' | fzf \
    --prompt='Go > ' \
    --height=100% \
    --layout=reverse \
    --border=sharp \
    --disabled \
    --bind "change:reload($SELF --calc-and-menu {q})")

[ -z "$chosen" ] && exit 0

case "$chosen" in
    "= "*)
        result=${chosen#= }
        printf '%s' "$result" | wl-copy
        command -v notify-send >/dev/null 2>&1 && notify-send "Calculator" "$result copied"
        ;;
    "Apps") run_applauncher ;;
    "Clipboard") run_clipboard ;;
    "System") run_system ;;
    "Power Mode") run_power_mode ;;
    "Wallpaper") run_wallpaper ;;
    "Update") run_update ;;
esac
