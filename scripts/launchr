#!/bin/sh
set -e

APP_DIRS="/usr/share/applications $HOME/.local/share/applications"
WMENU_OPTS="-i -N #1a1b26 -n #a9b1d6 -S #7aa2f7 -s #1a1b26"

list_apps() {
    for dir in $APP_DIRS; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.desktop; do
            [ -f "$f" ] || continue
            grep -q '^NoDisplay=true' "$f" && continue

            name=$(grep -m1 '^Name=' "$f" | cut -d'=' -f2-)
            exec_raw=$(grep -m1 '^Exec=' "$f" | cut -d'=' -f2-)

            [ -z "$name" ] && continue
            [ -z "$exec_raw" ] && continue

            exec_clean=$(echo "$exec_raw" | sed -E 's/%[fFuUdDnNickvm]//g')

            printf '%s\t%s\n' "$name" "$exec_clean"
        done
    done | sort -u -t"$(printf '\t')" -k1,1
}

calc_eval() {
    q="$1"
    [ -z "$q" ] && return 0

    case "$q" in
        *[!0-9+\-*/^\(\).\ ]*) return 0 ;;
    esac
    case "$q" in
        *[0-9]*) : ;;
        *) return 0 ;;
    esac

    result=$(printf '%s\n' "$q" | bc -l 2>/dev/null) || return 0
    [ -z "$result" ] && return 0
    printf '%s\n' "$result"
}

apps=$(list_apps)
chosen=$(printf '%s\n' "$apps" | cut -f1 | wmenu -l 15 -p "Launch>" $WMENU_OPTS)
[ -z "$chosen" ] && exit 0

cmd=$(printf '%s\n' "$apps" | awk -F'\t' -v n="$chosen" '$1==n {print $2; exit}')

if [ -z "$cmd" ]; then
    # No matching app — try to evaluate the typed text as a math expression
    result=$(calc_eval "$chosen")
    if [ -n "$result" ]; then
        printf '%s' "$result" | wl-copy
        notify-send "Calculator" "$chosen = $result (copied)"
    fi
    exit 0
fi

setsid -f sh -c "$cmd" >/dev/null 2>&1
