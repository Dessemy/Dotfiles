cmd open ${{

	dem() {
		{ setsid -f "$@" >/dev/null 2>&1& } \
			|| ({ nohup "$@" >/dev/null 2>&1& } &) \
			|| (exec "$@" >/dev/null 2>&1&)
	}

	real_f="$(readlink -f $f || realpath $f)" \

	mime_type="$(\
		exiftool -s3 -MIMEType "$real_f" 2>/dev/null \
			|| file --dereference -b --mime-type -- "$real_f" 2>/dev/null
	)"

	case "$mime_type" in
	(application/pdf | application/postscript | image/vnd.djvu |  application/epub*)
		dem xdg-open $fx
	;;
	(text/html)
		case "${f##*.}" in
		(xls) dem localc $f ;;
		(*) "${EDITOR:-nvim}" $fx
		esac
	;;
	(text/troff)
		case "${f##*.}" in
		([0-9] | [01]p | [23]*) man $fx ;;
		(*) "${EDITOR:-nvim}" $fx
		esac
	;;
	( text/* | application/json | application/javascript | \
	application/pgp-encrypted | inode/x-empty | application/octet-stream | \
	application/x-gettext-translation )
		"${EDITOR:-nvim}" $fx
	;;
	(image/x-*)
		dem "${IMAGE_VIEWER:-imv}" $fx
	;;
	(image/* )
		case "$(tty)" in
		("/dev/tty"*)
			"${MPV:-mpv}" --keep-open $fx
		;;
		(*) dem "${IMAGE_VIEWER:-imv}" $fx
		esac
	;;
	(audio/*)
		case "$(tty)" in
		("/dev/tty"*)
			"${AUDIO_PLAYER:-"${MPV:-mpv}"}" --audio-display=no $fx
		;;
		(*) dem "${TERMINAL:-foot}" -e "${AUDIO_PLAYER:-"${MPV:-mpv}"}" --audio-display=no $fx
		esac
	;;
	(video/*)
		case "$(tty)" in
		("/dev/tty"*)
			"${VIDEO_PLAYER:-"${MPV:-mpv}"}" $fx
		;;
		(*) dem "${VIDEO_PLAYER:-"${MPV:-mpv}"}" $fx
		esac
	;;
	(application/zip)
		aunpack $fx
	;;
	(*)
		case "$f" in
		( *.tar.bz | *.tar.bz2 | *.tbz | \
		*.tbz2 | *.tar.gz | *.tgz | *.tar.lzma | \
		*.tar.xz | *.txz | *.zip | *.rar | *.iso | \
		*.7z | *.cab | *.lha | *.lzh | *.arj | *.ace)
			clear; tput cup $(($(tput lines)/3)); tput bold
			printf -- "%s\n" "$f"
			printf "\t[v]iew (mount)  [e]xtract  [N]cancel: "
			read -r REPLY
			case "$REPLY" in
			(v|V)
				real_f="$(readlink -f "$f" || realpath "$f")"
				mp="$HOME/.local/share/lf/mounts/$(basename "$real_f")"
				mkdir -p "$mp"
				archivemount "$real_f" "$mp"
				lf -remote "send $id cd \"$mp\""
			;;
			(e|E)
				for f in $fx; do
					case "$f" in
					(*.iso)
						dest="${f%.iso}"
						mkdir -p "$dest"
						7z x -o"$dest" -- "$f"
					;;
					(*)
						aunpack "$f"
					;;
					esac
				done
			;;
			esac
		;;
		(*)
			for f in $fx; do
				dem "${OPENER:-xdg-open}" $f
			done
		;;
		esac
	;;
	esac
}}

cmd openwith ${{

	dem() {
		{ setsid -f "$@" >/dev/null 2>&1& } \
			|| ({ nohup "$@" >/dev/null 2>&1& } &) \
			|| (exec "$@" >/dev/null 2>&1&)
	}

	real_f="$(readlink -f $f || realpath $f)" \
	mime_type="$(\
		exiftool -s3 -MIMEType "$real_f" \
			|| file --dereference -b --mime-type -- "$real_f"
	)"

	menu_select() {
		nl -nln | fzf --with-nth 2.. | cut -d' ' -f1
	}

	case "$mime_type" in
	( text/* | application/json | application/javascript | \
	application/pgp-encrypted | inode/x-empty | application/octet-stream )
		app=$(menu_select <<-\EOF
		$EDITOR
		$EDITOR (new terminal)
		EOF
		)
		case "$app" in
		(1) "${EDITOR:-nvim}" $fx ;;
		(2) dem "${TERMINAL:-foot}" -e "$EDITOR" $fx ;;
		esac
	;;

	(image/svg+xml | image/png | image/jpeg | image/gif )
		app=$(menu_select <<-\EOF
		imv
		mpv
		EOF
		)
		case "$app" in
		(1) dem imv $fx ;;
		(2)
			case "$(tty)" in
			("/dev/tty"*) "${MPV:-mpv}" --keep-open=yes $fx ;;
			(*) dem "${MPV:-mpv}" --keep-open=yes $fx ;;
			esac
		;;
		esac
	;;

	(image/x-*)
		app=$(menu_select <<-\EOF
		imv
		mpv
		EOF
		)
		case "$app" in
		(1) dem imv $fx ;;
		(2)
			case "$(tty)" in
			("/dev/tty"*) "${MPV:-mpv}" --keep-open=yes $fx ;;
			(*) dem "${MPV:-mpv}" --keep-open=yes $fx ;;
			esac
			;;
		esac
	;;

	(audio/*)
		app=$(menu_select <<-\EOF
		mpv (background)
		mpv (foreground, only audio)
		EOF
		)
		case "$app" in
		(1) dem "${MPV:-mpv}" $fx ;;
		(2) echo; "${MPV:-mpv}" --audio-display=no $fx ;;
		esac
	;;

	(video/*)
		app=$(menu_select <<-\EOF
		mpv
		mpv (background, only audio)
		mpv (foreground, only audio)
		EOF
		)
		case "$app" in
		(1) dem "${MPV:-mpv}" $fx ;;
		(2) dem "${MPV:-mpv}" --video=no --audio-display=no $fx ;;
		(3) echo; "${MPV:-mpv}" --video=no --audio-display=no $fx ;;
		esac
	esac
}}

%test $LF_LEVEL -eq 1 || >&2 printf "Warning: You're in a nested lf instance!"

cmd mkdir $mkdir -p "$(echo $* | tr ' ' '\ ')"
cmd trash %trash-put $fx

cmd delete ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx | sed 's|'"$HOME"'||'
	printf "\t\033[1;33mRemove? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yY]) rm -rf -- $fx ;;
	esac
}}

cmd chmodx &{{
	chmod u+x $fx
	lf -remote "send $id reload"
}}

cmd shred ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx | sed 's|'"$HOME"'||'
	printf "\t\033[1;34mShred? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yY])
			for f in $fx; do
				if [ -f "$f" ]; then
					shred -u -n 3 "$f" >/dev/null 2>&1 &
				elif [ -d "$f" ]; then
					find "$f" -type f -exec shred -u -n 3 {} \; >/dev/null 2>&1
					rm -rf -- "$f"
				fi
			done
		;;
	esac
}}

cmd rename_nvim ${{
	old="$f"
	dir=$(dirname -- "$old")
	base=$(basename -- "$old")
	tmpfile=$(mktemp)
	printf '%s\n' "$base" > "$tmpfile"
	"${EDITOR:-nvim}" "$tmpfile"
	newname=$(head -n1 "$tmpfile")
	rm -f "$tmpfile"
	if [ -z "$newname" ] || [ "$newname" = "$base" ]; then
		exit 0
	fi
	if [ -e "$dir/$newname" ]; then
		lf -remote "send $id echo target already exists"
		exit 1
	fi
	mv -- "$old" "$dir/$newname"
	lf -remote "send $id reload"
	lf -remote "send $id select \"$dir/$newname\""
}}

cmd compress ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	printf "\tArchive format:\n"
	printf "\t1) zip\n"
	printf "\t2) tar\n"
	printf "\t3) tar.gz\n"
	printf "\t4) tar.bz2\n"
	printf "\t5) tar.xz\n"
	printf "\t6) 7z\n"
	printf "\t7) rar\n"
	printf "\tChoice: "
	read -r choice
	case "$choice" in
		1) ext=zip ;;
		2) ext=tar ;;
		3) ext=tar.gz ;;
		4) ext=tar.bz2 ;;
		5) ext=tar.xz ;;
		6) ext=7z ;;
		7) ext=rar ;;
		(*) exit 0 ;;
	esac
	printf "\tArchive name (without extension): "
	read -r name
	[ -z "$name" ] && name="archive"
	apack "${name}.${ext}" $fx
	lf -remote "send $id reload"
}}

cmd extract ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx
	printf "\t\033[1;34mExtract? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yY])
			for f in $fx; do
				case "$f" in
				(*.iso)
					dest="${f%.iso}"
					mkdir -p "$dest"
					7z x -o"$dest" -- "$f"
				;;
				(*)
					aunpack "$f"
				;;
				esac
			done
		;;
	esac
}}

cmd moveto ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	clear
	echo "Move to where?"
	if dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-"$HOME/.config"}/shell/bm-dirs" \
			| fzf \
			| sed 's|~|$HOME|'
		)"
	then
		for x in $fx; do
			eval mv -iv \"$x\" \"$dest\"
		done &&
			notify-send "lf" "File(s) moved to $dest"
	fi
}}

cmd copyto ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	clear
	echo "Copy to where?"
	dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-"$HOME/.config"}/shell/bm-dirs" \
		| fzf \
		| sed 's|~|$HOME|')" &&
	for x in $fx; do
		eval cp -ivr \"$x\" \"$dest\"
	done &&
	notify-send "lf" "File(s) copied to $dest"
}}

cmd paste_force %{{
	IFS='
'
	set -- $(cat ~/.local/share/lf/files)
	mode="$1"
	shift
	if [ $# -lt 1 ]; then
		lf -remote "send $id echo no files to paste"
		exit 1
	fi

	rename_conflict() {
		base="$1"
		if [ -n "${base%.*}" ] && [ "$base" != "${base%.*}" ]; then
			stem="${base%.*}"
			ext=".${base##*.}"
		else
			stem="$base"
			ext=""
		fi
		i=1
		newname="${stem}_${i}${ext}"
		while [ -e "./$newname" ]; do
			i=$((i+1))
			newname="${stem}_${i}${ext}"
		done
		printf '%s' "$newname"
	}

	replace_all=0
	for f in "$@"; do
		name=$(basename -- "$f")
		dest="./$name"
		if [ -e "$dest" ]; then
			if [ "$replace_all" -eq 1 ]; then
				REPLY=y
			else
				clear; tput cup $(($(tput lines)/3)); tput bold
				printf "\t%s already exists.\n" "$name"
				printf "\treplace? [y/n/a] "
				read -r REPLY
			fi
			case "$REPLY" in
			a)
				replace_all=1
				case "$mode" in
				copy) cp -rf -- "$f" "$dest" ;;
				move) mv -f -- "$f" "$dest" ;;
				esac
			;;
			y)
				case "$mode" in
				copy) cp -rf -- "$f" "$dest" ;;
				move) mv -f -- "$f" "$dest" ;;
				esac
			;;
			(*)
				newname=$(rename_conflict "$name")
				case "$mode" in
				copy) cp -r -- "$f" "./$newname" ;;
				move) mv -- "$f" "./$newname" ;;
				esac
			;;
			esac
		else
			case "$mode" in
			copy) cp -r -- "$f" "$dest" ;;
			move) mv -- "$f" "$dest" ;;
			esac
		fi
	done
	rm ~/.local/share/lf/files
	lf -remote "send clear"
	lf -remote "send $id reload"
}}

cmd paste_link %{{
	IFS='
'
	set -- $(cat ~/.local/share/lf/files)
	mode="$1"
	shift
	if [ $# -lt 1 ]; then
		lf -remote "send $id echo no files to link"
		exit 1
	fi
	case "$mode" in
		copy) ln -sr -t . -- "$@";;
		move) ln -t . -- "$@";;
	esac \
		|| exit $?
	rm ~/.local/share/lf/files
	lf -remote "send clear"
}}

cmd unmount_archive ${{
	case "$PWD" in
	("$HOME/.local/share/lf/mounts/"*)
		mp="$PWD"
		lf -remote "send $id updir"
		fusermount -u "$mp" 2>/dev/null && rmdir "$mp" 2>/dev/null
	;;
	(*)
		lf -remote "send $id echo 'not an archive mount folder'"
	;;
	esac
}}

cmd follow_link %{{
	lf -remote "send ${id} select \"$(readlink $f)\""
}}

cmd zoxide %{{
	lf -remote "send ${id} cd \"$(zoxide query -- $*)\""
}}

cmd zoxide_i ${{
	dir=$(zoxide query -l -s "$@" \
		| fzf --nth 2.. --tac +s -e \
			--header "Frecent directories" --header-first \
			--preview "lsd --color always --icon never --tree --depth 3 --group-dirs first {+2} 2>/dev/null" \
		| awk '{print substr($0, index($0,$2))}'
	)
	lf -remote "send ${id} cd \"${dir}\""
}}

cmd stop ${{
	kill -TSTP $(ps -p $$ -o 'ppid=')
}}

